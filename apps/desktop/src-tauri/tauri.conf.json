{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Risk Planner",
  "version": "0.1.0",
  "identifier": "local.planner.projectrisk",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Project Risk Planner", "width": 1600, "height": 1000, "minWidth": 1100, "minHeight": 720 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"], "shortDescription": "Local project schedule and risk simulator" }
}
