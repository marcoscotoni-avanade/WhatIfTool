{
  "name": "project-risk-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "preview": "vite preview --config apps/desktop/vite.config.ts --host 127.0.0.1 --port 1421",
    "build": "tsc --noEmit && vite build --config apps/desktop/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "service": "tsx apps/planner-service/src/index.ts",
    "mcp": "tsx apps/mcp-server/src/index.ts",
    "desktop": "npm run tauri:dev --workspace @planner/desktop",
    "desktop:build": "npm run tauri:build --workspace @planner/desktop"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@xyflow/react": "^12.9.0",
    "ag-grid-community": "^34.3.0",
    "ag-grid-react": "^34.3.0",
    "elkjs": "^0.11.0",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.13.0",
    "zustand": "^5.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "tsx": "^4.23.15",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
